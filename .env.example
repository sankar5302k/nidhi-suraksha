# ==============================================================================
# Nidhi Suraksha - "Verify. Track. Release."
# Environment Configuration Template
# ==============================================================================

# Application & Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase Auth & Relational DB
# Note: SUPABASE_SERVICE_ROLE_KEY is server-only. Never expose to client!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Supabase JWT Secret (from Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-at-least-32-chars

# MongoDB 7 (Local single-node replica set with auth)
# For Atlas, replace with your mongodb+srv connection string and TLS parameters
MONGODB_URI=mongodb://app:AppSecretPassword123!@127.0.0.1:27017/nidhi_suraksha?authSource=nidhi_suraksha&replicaSet=rs0

# Cryptographic Keys (Must be 32-byte hex strings = 64 hex characters)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HMAC_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
CSRF_SECRET=csrf_secret_random_token_key_change_in_production_min32

# LLM Configuration (Groq API - openai/gpt-oss-120b)
# Provider options: 'groq' | 'mock'
LLM_PROVIDER=mock
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com
# Daily per-user AI quota limit
AI_DAILY_BUDGET=50

# Storage Provider (gridfs | supabase)
STORAGE_PROVIDER=gridfs
