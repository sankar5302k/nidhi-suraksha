# ==============================================================================
# Nidhi Suraksha - Backend Environment Configuration (Render & Production)
# ==============================================================================

# Application & Server
# Render automatically sets PORT (e.g. 10000). Leave PORT empty or 5000.
NODE_ENV=production
PORT=5000

# Client Origins for CORS (Support single URL or comma-separated list of origins)
# Set to your deployed Vercel frontend URL, e.g. https://nidhi-suraksha.vercel.app
CLIENT_URL=https://your-frontend-app.vercel.app,http://localhost:5173

# Auto-seed sample institutions and demonstration records on first boot if DB is empty
AUTO_SEED=true

# MongoDB Database Connection String (MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/nidhi_suraksha?retryWrites=true&w=majority

# Cryptographic Keys (Must be 32-byte hex strings = exactly 64 hex characters)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HMAC_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
CSRF_SECRET=csrf_secret_random_token_key_change_in_production_min32

# LLM Document Parsing Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com
AI_DAILY_BUDGET=50

# Storage Provider (gridfs stores encrypted documents directly inside MongoDB)
STORAGE_PROVIDER=gridfs

# Supabase Auth & DB (Optional/Fallback)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=development-supabase-jwt-secret-placeholder-32bytes!
